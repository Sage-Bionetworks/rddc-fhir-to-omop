// Resource labels. Same names and shape as rddc-genomics-workflows/conf/base.config.
// DuckDB spills to disk past memory_limit, so memory sets speed more than feasibility.

process {
    cpus   = 1
    memory = 2.GB
    time   = 2.h

    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 143] ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: process_single {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
    withLabel: process_low {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withLabel: process_medium {
        cpus   = 6
        memory = { 36.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }
    withLabel: process_high {
        cpus   = 12
        memory = { 72.GB * task.attempt }
        time   = { 16.h * task.attempt }
    }
}
