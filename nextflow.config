manifest {
    name            = 'rddc-fhir-to-omop'
    description     = 'Prototype: FHIR R4 to OMOP CDM 5.4 on a single node with DuckDB'
    homePage        = 'https://github.com/Sage-Bionetworks/rddc-fhir-to-omop'
    license         = 'Apache-2.0'
    version         = '0.1.0.dev0'   // keep equal to the image tag in process.container below
    mainScript      = 'main.nf'
    nextflowVersion = '!>=25.04.0'
}

params {
    sidecar = null  // the batch's _sidecar.json (declared again in main.nf with its defaults)
    outdir = null   // where results are published
}

includeConfig 'conf/base.config'

process {
    // Built from ./Dockerfile (make image); published with `make push-image`. Cirro pulls it.
    container = 'ghcr.io/sage-bionetworks/rddc-fhir-to-omop:0.1.0.dev0'
}

profiles {
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    // No container: uses the duckdb CLI on PATH, or the one `make tools` puts in .tools/.
    local {
        process.container = null
        env.PATH          = "${projectDir}/.tools:\$PATH"
    }
    // Small resources and the bundled Synthea fixture.
    test {
        params.sidecar   = "${projectDir}/tests/data/batch/_sidecar.json"
        params.vocab_dir = "${projectDir}/tests/data/vocab_mini"
        params.outdir    = 'results'
        params.strict_qc = true
        params.max_unmapped_pct = 100   // vocab_mini has ~40 concepts; most codes are unmapped
        process.resourceLimits = [cpus: 2, memory: 6.GB, time: 1.h]
    }
}
